# Copy to .env and adjust. Restart `npm run dev` after changing these.

# Which parts of the app use the FastAPI backend (comma-separated). Everything not listed
# runs in the browser with localStorage. Leave empty to run fully in the browser, no server needed.
#   auth      sign up, sign in (password or Face ID), Face ID enrol/delete
#   employer  job postings, applications, candidate ranking (needs auth too)
#   candidate CV analysis, mock interviews (Gemini, Whisper), progress (needs auth too)
#   admin     configuration screens: domains, roles, skills, questions, criteria, rules, users (needs auth too)
VITE_BACKEND_MODULES=auth,employer,candidate,admin

# Base URL of the FastAPI backend including the /api prefix, without a trailing slash.
VITE_API_URL=http://localhost:8000/api

# Optional: self-host the MediaPipe face model (defaults to Google's public face_landmarker.task)
# VITE_FACE_MODEL_URL=/models/face_landmarker.task
