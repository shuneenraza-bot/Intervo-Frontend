# Copy to .env and adjust. Restart `npm run dev` after changing these.

# false (default) = run fully in the browser with localStorage, no server needed.
# true            = send data operations to the FastAPI backend below (see API.md).
VITE_USE_BACKEND=false

# Base URL of the FastAPI backend, without a trailing slash.
VITE_API_URL=http://localhost:8000
